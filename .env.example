# --- Supabase (wartości z `npx supabase status` lokalnie lub z panelu projektu) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# tylko po stronie serwera i w taskach Trigger.dev; nigdy w kodzie klienckim
SUPABASE_SERVICE_ROLE_KEY=

# --- Trigger.dev (Project settings -> API keys; ref w formacie proj_...) ---
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Cron (Vercel dołącza go jako "Authorization: Bearer ..." do wywołań z vercel.json) ---
CRON_SECRET=

# --- Silniki: ChatGPT (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Silniki: Perplexity ---
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast

# --- Silniki: Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Silniki: Google AI Overviews (DataForSEO) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2616 = Polska
DATAFORSEO_LOCATION_CODE=2616

# --- Anthropic (sentyment odpowiedzi i generator promptów) ---
ANTHROPIC_API_KEY=
ANTHROPIC_SENTIMENT_MODEL=claude-haiku-5-5
ANTHROPIC_GENERATOR_MODEL=claude-opus-5-5

# --- Opcjonalnie: test RLS na żywej bazie (`npm test -- tests/db`), nie jest potrzebna aplikacji ---
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
