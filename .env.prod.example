# Szablon zmiennych produkcyjnych. Skopiuj do `.env.prod.local` (ignorowany przez git) i uzupełnij wartości puste.
#   cp .env.prod.example .env.prod.local
# Jeden plik zasila dwie usługi:
#   - Vercel (aplikacja):    bash scripts/push-env-vercel.sh
#   - Trigger.dev (taski):   npx trigger.dev@latest deploy  (rozszerzenie syncEnvVars w trigger.config.ts)
# Format: NAZWA=wartość, jedna zmienna w linii. Komentarze tylko w osobnych liniach (bez komentarzy po wartości).
# Oznaczenia: [V] = Vercel, [T] = Trigger.dev.

# --- Supabase (projekt produkcyjny gfnzjjakugwusxnzpdbz) ---
# [V][T] Adres projektu: Supabase -> Project Settings -> API -> Project URL (wartość znana, już wpisana)
NEXT_PUBLIC_SUPABASE_URL=https://gfnzjjakugwusxnzpdbz.supabase.co
# [V] Klucz publiczny: Supabase -> Project Settings -> API -> anon public (nowe projekty: publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [V][T] Klucz tylko serwerowy: Supabase -> Project Settings -> API -> service_role (nowe projekty: secret key). Nigdy w kodzie klienckim
SUPABASE_SERVICE_ROLE_KEY=

# --- Trigger.dev ---
# [V] Klucz PRODUKCYJNY (zaczyna się od tr_prod_): Trigger.dev -> projekt -> API keys -> środowisko Prod
TRIGGER_SECRET_KEY=
# [V] ID projektu Trigger.dev (Project settings; wartość znana, już wpisana)
TRIGGER_PROJECT_REF=proj_sitwivdlindrogesffbq

# --- Cron ---
# [V] Dowolny długi losowy ciąg, np. `openssl rand -hex 32`. Vercel dołącza go jako "Authorization: Bearer ..." do wywołań z vercel.json
CRON_SECRET=

# --- Silniki: ChatGPT (OpenAI) ---
# [T] OpenAI Platform -> API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Silniki: Perplexity ---
# [T] Perplexity -> Settings -> API -> API Keys
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast

# --- Silniki: Gemini (Google AI Studio) ---
# [T] Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Silniki: Google AI Overviews (DataForSEO) ---
# [T] DataForSEO -> Dashboard -> API Access (login to e-mail konta, hasło to hasło API, nie hasło do panelu)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# [T] 2616 = Polska
DATAFORSEO_LOCATION_CODE=2616

# --- Anthropic (sentyment odpowiedzi, generator promptów, rekomendacje) ---
# [V][T] console.anthropic.com -> Settings -> API keys
ANTHROPIC_API_KEY=
# [V][T] Modele (te same wartości co w .env.example)
ANTHROPIC_SENTIMENT_MODEL=claude-haiku-5-5
ANTHROPIC_GENERATOR_MODEL=claude-opus-5-5
# Opcjonalnie [V][T]: model generujący rekomendacje (domyślnie claude-opus-5-5). Odkomentuj i uzupełnij, jeśli chcesz zmienić
# ANTHROPIC_RECOMMENDER_MODEL=
# Opcjonalnie [V][T]: wymagane, gdy klucz API nie jest przypisany do workspace'u w console.anthropic.com
# ANTHROPIC_WORKSPACE_ID=
